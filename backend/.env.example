# MINDBRIDGE Environment Configuration (SIH 25092)
PORT=5000
NODE_ENV=development

# Database: SQLite for instant offline dev, or switch to PostgreSQL
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mindbridge?schema=public"

# Security Secrets
JWT_SECRET="mindbridge_jwt_secret_key_sih25092_secure_token_random_2026"
JWT_EXPIRES_IN="1d"

# CORS configuration
CORS_ORIGIN="http://localhost:5173"

# AI Configuration (Optional Gemini key; offline supportive assistant works without it)
GEMINI_API_KEY=""
AI_MOCK_MODE=true

# Institutional Emergency Hotlines
DEFAULT_CRISIS_HOTLINE="14416" # National Tele-MANAS
NATIONAL_KIRAN_HOTLINE="1800-599-0019"
CAMPUS_SECURITY_HOTLINE="112"
